# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design handoff reference files (not part of the production site)
/design_handoff_portfolio_site/
/design_handoff_portfolio_site*/

# source assets for the hero portrait bake — large, and only needed to re-run
# `npm run bake:head`. The shipped artefact is public/assets/head-cloud.bin
/assets-src/
